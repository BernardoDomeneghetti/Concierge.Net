{
  "info": {
    "_postman_id": "3c4d5e6f-7a8b-4c9d-8e0f-1a2b3c4d5e6f",
    "name": "Concierge.Net - Resident API",
    "description": "Collection para testar o ciclo de vida completo da entidade Resident (Register, GetById, Update, Inactivate) no Concierge.Net.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Residents",
      "item": [
        {
          "name": "1. Register Resident",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData && jsonData.id) {",
                  "        pm.collectionVariables.set('residentId', jsonData.id);",
                  "        pm.environment.set('residentId', jsonData.id);",
                  "        console.log('Saved residentId:', jsonData.id);",
                  "    }",
                  "}",
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}",
                "description": "Correlation ID para rastreamento nos logs"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Carlos Eduardo Silva\",\n  \"cpf\": \"123.456.789-01\",\n  \"email\": \"carlos@condominio.com\",\n  \"mobilePhone\": \"(11) 98765-4321\",\n  \"photoUrl\": \"https://cdn.condominio.com/photos/carlos.jpg\",\n  \"unitId\": \"{{unitId}}\",\n  \"residentType\": \"Owner\",\n  \"notificationChannel\": \"All\"\n}"
            },
            "url": {
              "raw": "{{residentBaseUrl}}/api/residents",
              "host": [
                "{{residentBaseUrl}}"
              ],
              "path": [
                "api",
                "residents"
              ]
            },
            "description": "Cadastra um novo morador no condomínio e gera o evento `ResidentRegisteredDomainEvent` no Outbox."
          },
          "response": []
        },
        {
          "name": "2. Get Resident By Id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{residentBaseUrl}}/api/residents/{{residentId}}",
              "host": [
                "{{residentBaseUrl}}"
              ],
              "path": [
                "api",
                "residents",
                "{{residentId}}"
              ]
            },
            "description": "Consulta os dados cadastrais e o status atual (`Active` ou `Inactive`) do morador."
          },
          "response": []
        },
        {
          "name": "3. Update Resident",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Carlos Eduardo da Silva\",\n  \"email\": \"carlos.silva@condominio.com\",\n  \"mobilePhone\": \"(11) 99999-8888\",\n  \"photoUrl\": \"https://cdn.condominio.com/photos/carlos-v2.jpg\",\n  \"unitId\": \"{{unitId}}\",\n  \"residentType\": \"Owner\",\n  \"notificationChannel\": \"Email, Sms\"\n}"
            },
            "url": {
              "raw": "{{residentBaseUrl}}/api/residents/{{residentId}}",
              "host": [
                "{{residentBaseUrl}}"
              ],
              "path": [
                "api",
                "residents",
                "{{residentId}}"
              ]
            },
            "description": "Atualiza os dados cadastrais e preferências de notificação do morador e gera o evento `ResidentUpdatedDomainEvent` no Outbox."
          },
          "response": []
        },
        {
          "name": "4. Inactivate Resident",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Mudou-se do imóvel\"\n}"
            },
            "url": {
              "raw": "{{residentBaseUrl}}/api/residents/{{residentId}}/inactivate",
              "host": [
                "{{residentBaseUrl}}"
              ],
              "path": [
                "api",
                "residents",
                "{{residentId}}",
                "inactivate"
              ]
            },
            "description": "Inativa o cadastro do morador quando ele deixa o imóvel e gera o evento `ResidentInactivatedDomainEvent` no Outbox."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "residentBaseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "residentId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "unitId",
      "value": "22222222-2222-2222-2222-222222222222",
      "type": "string"
    }
  ]
}
